[Unit]
Description=Sub2API Telegram Bot
After=network-online.target sub2api.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt
EnvironmentFile=/etc/sub2api-bot.env
ExecStart=/usr/bin/python3 /opt/sub2api-telegram-bot.py
Restart=always
RestartSec=5
StandardOutput=append:/tmp/sub2api_telegram_bot.log
StandardError=append:/tmp/sub2api_telegram_bot.log

[Install]
WantedBy=multi-user.target
