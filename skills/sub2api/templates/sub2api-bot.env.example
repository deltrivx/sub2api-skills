# Sub2API Telegram Bot 配置示例
# 复制到 /etc/sub2api-bot.env 后填写真实值，切勿提交真实配置。

SUB2API_BASE_URL=https://<your-sub2api-host>
SUB2API_ADMIN_EMAIL=<admin@example.com>
SUB2API_ADMIN_PASSWORD=<admin-password>
SUB2API_DB_NAME=sub2api
SUB2API_DB_USER=postgres

TELEGRAM_BOT_TOKEN=<telegram-bot-token>
SUB2API_BOT_ALLOWED_CHAT_IDS=<telegram-chat-id-1>,<telegram-chat-id-2>

SUB2API_MONITOR_STATE_FILE=/tmp/sub2api_monitor_state.json
SUB2API_BOT_OFFSET_FILE=/tmp/sub2api_bot_offset.txt
SUB2API_BOT_MUTE_FILE=/tmp/sub2api_bot_mute_until.txt
SUB2API_BOT_IMPORT_DIR=/tmp/sub2api_bot_imports
SUB2API_MONITOR_LOG=/tmp/sub2api_monitor.log
SUB2API_BOT_LOG=/tmp/sub2api_telegram_bot.log

# 可选：Telegram 网络代理，由 systemd 读取后传入环境。
HTTP_PROXY=http://<proxy-host>:<proxy-port>
HTTPS_PROXY=http://<proxy-host>:<proxy-port>
NO_PROXY=localhost,127.0.0.1,<your-lan-cidr>
