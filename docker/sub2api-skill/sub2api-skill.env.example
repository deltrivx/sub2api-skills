TZ=Asia/Shanghai

# ===== 通用配置（两个后端共用） =====
SUB2API_BASE_URL=http://127.0.0.1:8008
# 选择后端：telegram | qq
SUB2API_BOT_BACKEND=telegram

# 白名单（逗号分隔）：
#   telegram 用 chat_id
#   qq 用 channel:<channel_id> / group:<group_openid> / c2c:<user_openid>，或裸 openid/id
SUB2API_BOT_ALLOWED_CHAT_IDS=123456789

SUB2API_ADMIN_EMAIL=admin@example.com
SUB2API_ADMIN_PASSWORD_B64=base64_of_admin_password

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=moviepilot
DATABASE_PASSWORD=replace_me
DATABASE_DBNAME=sub2api

SUB2API_CONTAINER_NAME=sub2api
SUB2API_BOT_CONTAINER_NAME=sub2api-skill

# ===== Telegram 后端凭据（SUB2API_BOT_BACKEND=telegram 时必填） =====
TELEGRAM_BOT_TOKEN=123456789:replace_me

# ===== QQ Bot 后端凭据（SUB2API_BOT_BACKEND=qq 时必填） =====
# 在 https://q.qq.com 创建机器人后获取 AppID / AppSecret
QQ_APP_ID=replace_me_qq_app_id
QQ_APP_SECRET=replace_me_qq_app_secret
# 沙箱模式：SUB2API_QQ_SANDBOX=1
SUB2API_QQ_SANDBOX=

# ===== 代理（可选）=====
HTTP_PROXY=http://proxy.example.lan:7890
HTTPS_PROXY=http://proxy.example.lan:7890
NO_PROXY=localhost,127.0.0.1,*.local,lan.example
http_proxy=http://proxy.example.lan:7890
https_proxy=http://proxy.example.lan:7890
no_proxy=localhost,127.0.0.1,*.local,lan.example

# ===== Sub2API 部署相关（/update 用）=====
SUB2API_DEPLOY_DIR=/sub2api-compose
SUB2API_IMAGE=weishaw/sub2api:latest
DOCKER_COMPOSE_CMD=docker compose
